/// net_exec_x(object_index)
// v2.2.1: объекты казней, которые в игре НЕ наследуют objPlayer (бензопила по сидящему врагу,
// вторая казнь бутылкой). Пока такая казнь идёт, objPlayer на уровне нет —
// раньше хост считал, что игрока нет: аватары клиентов удалялись и создавались заново у
// казнящего («всех телепортирует»), а казнь клиента вообще не находилась.
var o = argument0;
return o == objPKillChainsawLean || o == objPKillBottle2;
